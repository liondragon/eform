{
  "id": "virtual-estimate",
  "version": "2",
  "title": "Virtual Estimate",
  "result_pages": {
    "success": {
      "title": "Your Estimate Request Was Sent",
      "message": "Thank you for sending your project details. We will review the information and follow up within 2 business days. If the floor or project scope needs a closer inspection, we will discuss whether an in-person estimate makes sense.\n\nThe Flooring Artists Team"
    }
  },
  "email": {
    "to": "office@flooringartists.com",
    "subject": "Virtual Estimate - {{field.name}} - {{field.zip_us}}",
    "email_template": "default",
    "include_fields": [
      "name",
      "email",
      "tel_us",
      "zip_us",
      "square_footage",
      "project_description",
      "listing_url",
      "project_photos",
      "submitted_at",
      "submission_id"
    ],
    "display_format_tel": "xxx-xxx-xxxx"
  },
  "rules": [
    {
      "rule": "one_of",
      "fields": [
        "listing_url",
        "project_photos"
      ],
      "message": "Please provide a listing URL or upload at least one photo."
    }
  ],
  "fields": [
    {
      "type": "row_group",
      "mode": "start",
      "tag": "section",
      "class": "virtual-estimate-section virtual-estimate-section--contact"
    },
    {
      "key": "name",
      "type": "name",
      "label": "Your name",
      "required": true,
      "placeholder": "Your name *",
      "autocomplete": "name",
      "before_html": "<h2>Contact information</h2>"
    },
    {
      "key": "email",
      "type": "email",
      "label": "Email",
      "required": true,
      "placeholder": "Email address *",
      "autocomplete": "email"
    },
    {
      "key": "tel_us",
      "type": "tel_us",
      "label": "Phone",
      "required": true,
      "placeholder": "Phone number *",
      "autocomplete": "tel"
    },
    {
      "key": "zip_us",
      "type": "zip_us",
      "label": "Project ZIP code",
      "required": true,
      "placeholder": "Project ZIP code *",
      "autocomplete": "postal-code"
    },
    {
      "type": "row_group",
      "mode": "end"
    },
    {
      "type": "row_group",
      "mode": "start",
      "tag": "section",
      "class": "virtual-estimate-section virtual-estimate-section--project"
    },
    {
      "key": "square_footage",
      "type": "number",
      "label": "Approximate total square footage",
      "required": true,
      "placeholder": "Approximate square footage *",
      "min": 1,
      "step": 1,
      "unit": "sqft",
      "before_html": "<h2>Project details</h2>"
    },
    {
      "key": "listing_url",
      "type": "url",
      "label": "Real-estate listing URL",
      "placeholder": "Listing URL (e.g. https://zillow.com/...)"
    },
    {
      "key": "project_description",
      "type": "textarea",
      "label": "Project description",
      "required": true,
      "max_length": 2000,
      "placeholder": "Example: Refinish hardwood in the living room and hallway, about 650 sq ft. A few pet stains near the entry.",
      "after_html": "<p class=\"virtual-estimate-help\">Tell us which rooms need work, approximate square footage, stairs or landings, repairs, and whether you need installation, refinishing, or demolition.</p>"
    },
    {
      "type": "row_group",
      "mode": "end"
    },
    {
      "type": "row_group",
      "mode": "start",
      "tag": "section",
      "class": "virtual-estimate-section virtual-estimate-section--photos"
    },
    {
      "key": "project_photos",
      "type": "files",
      "label": "Choose photos",
      "accept": [
        "image"
      ],
      "upload_mode": "staged",
      "max_file_bytes": 20971520,
      "max_files": 24,
      "max_total_bytes": 314572800,
      "email_attach": false,
      "before_html": "<h2>Project photos</h2><p class=\"virtual-estimate-section-copy\">Provide a real-estate listing URL above or upload at least one photo. For photos, show the full areas that need work and any damaged or unusual sections.</p>"
    },
    {
      "type": "row_group",
      "mode": "end"
    }
  ],
  "submit_button_text": "Send Estimate Request"
}
