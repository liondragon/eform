{
  "id": "upload-test",
  "version": "2",
  "title": "Upload Test",
  "result_pages": {
    "success": {
      "message": "OK"
    }
  },
  "email": {
    "to": "office@flooringartists.com",
    "subject": "Upload",
    "email_template": "default",
    "include_fields": [
      "name",
      "file1",
      "photos"
    ]
  },
  "fields": [
    {
      "key": "name",
      "type": "name",
      "label": "Name"
    },
    {
      "key": "file1",
      "type": "file",
      "label": "File",
      "accept": [
        "pdf"
      ],
      "email_attach": true
    },
    {
      "key": "photos",
      "type": "files",
      "label": "Photos",
      "accept": [
        "image"
      ],
      "upload_mode": "staged",
      "max_file_bytes": 20971520,
      "max_files": 24,
      "max_total_bytes": 314572800,
      "email_attach": false
    }
  ],
  "submit_button_text": "Send"
}
