{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eforms-media",
  "main": "src/index.js",
  "compatibility_date": "2026-07-22",
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "eforms-artifacts"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "2026072201",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "cache": {
    "enabled": true
  }
}
